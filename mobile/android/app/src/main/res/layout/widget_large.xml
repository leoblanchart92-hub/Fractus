<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView android:id="@+id/dot" android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/dot_off" android:contentDescription="@null" />
        <TextView
            android:id="@+id/txt_state"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Fractus"
            android:textColor="@color/fx_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/txt_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fx_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- La demande en attente : visible seulement s'il y en a une -->
    <LinearLayout
        android:id="@+id/pending_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:padding="10dp"
        android:background="@drawable/widget_pending"
        android:visibility="gone">
        <TextView
            android:id="@+id/txt_pending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fx_ink"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/btn_deny"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/widget_deny"
                android:text="Refuser"
                android:textColor="@color/fx_ink"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/btn_allow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:background="@drawable/widget_allow"
                android:text="Autoriser"
                android:textColor="#FF07101C"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/txt_last"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:gravity="top"
        android:textColor="@color/fx_dim"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.15"
        android:ellipsize="end" />

    <include layout="@layout/widget_buttons" />
</LinearLayout>
